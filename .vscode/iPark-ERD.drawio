<mxfile host="app.diagrams.net"><diagram id="ipark-erd" name="iPark ERD"><mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="iPark — Entity Relationship Diagram" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="150" y="15" width="900" height="45" as="geometry"/></mxCell><mxCell id="users" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:10px;border-bottom:2px solid #334155&quot;&gt;adminUsers&lt;/div&gt;&lt;div style=&quot;padding:12px 16px;line-height:1.8&quot;&gt;uid (PK)&lt;br&gt;name&lt;br&gt;username&lt;br&gt;email&lt;br&gt;role&lt;br&gt;approved&lt;br&gt;blocked&lt;br&gt;failedAttempts&lt;br&gt;requestedAt&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;fontFamily=Helvetica;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="300" height="340" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:10px;border-bottom:2px solid #334155&quot;&gt;adminSessions&lt;/div&gt;&lt;div style=&quot;padding:12px 16px;line-height:1.8&quot;&gt;sessionId (PK)&lt;br&gt;uid (FK)&lt;br&gt;name&lt;br&gt;username&lt;br&gt;email&lt;br&gt;role&lt;br&gt;loginTime&lt;br&gt;logoutTime&lt;br&gt;status&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;fontFamily=Helvetica;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="120" width="300" height="340" as="geometry"/></mxCell><mxCell id="slots" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:10px;border-bottom:2px solid #334155&quot;&gt;parkingSlots&lt;/div&gt;&lt;div style=&quot;padding:12px 16px;line-height:1.8&quot;&gt;slotId (PK)&lt;br&gt;occupied&lt;br&gt;status&lt;br&gt;sensorStatus&lt;br&gt;timeIn&lt;br&gt;timeOut&lt;br&gt;management.enabled&lt;br&gt;management.reason&lt;br&gt;management.details&lt;br&gt;management.updatedBy (FK)&lt;br&gt;management.updatedAt&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;fontFamily=Helvetica;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="300" height="400" as="geometry"/></mxCell><mxCell id="history" value="&lt;div style=&quot;font-size:18px;font-weight:bold;text-align:center;padding:10px;border-bottom:2px solid #334155&quot;&gt;parkingHistory&lt;/div&gt;&lt;div style=&quot;padding:12px 16px;line-height:1.8&quot;&gt;recordId (PK within slot)&lt;br&gt;slotId (FK; parent path)&lt;br&gt;timeIn&lt;br&gt;timeOut&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#334155;fontColor=#0f172a;fontFamily=Helvetica;fontSize=13;spacing=0;" vertex="1" parent="1"><mxGeometry x="740" y="650" width="300" height="210" as="geometry"/></mxCell><mxCell id="user_sessions" value="has sessions
1 admin → 0..* sessions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=none;endArrow=none;strokeColor=#334155;strokeWidth=2;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="users" target="sessions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="user_slots" value="updates management
0..1 admin per slot; 0..* slots per admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=none;endArrow=none;strokeColor=#334155;strokeWidth=2;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="users" target="slots"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="slot_history" value="has parking records
1 slot → 0..* records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;startArrow=none;endArrow=none;strokeColor=#334155;strokeWidth=2;fontSize=13;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.48;" edge="1" parent="1" source="slots" target="history"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="PK = primary key    FK = logical foreign key    0..* = zero or many
management is nested inside parkingSlots, not a fifth entity.
management.updatedBy records the latest editor, not every past editor.
History records are identified by slotId + recordId; slotId comes from the parent path.
Firebase relationships are logical and are not enforced as SQL foreign keys." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="420" y="920" width="650" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>